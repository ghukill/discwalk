# Godot 4 caches / imports
.godot/
*.import
# ...except a course's import settings: its heightmap ships as the raw PNG
# ("keep"), its aerial photo not at all ("skip"). See docs/COURSE_FORMAT.md.
!data/courses/*/*.import
*.uid.tmp

# Exports
/build/
/builds/
*.dmg
*.app
*.zip

# OS cruft
.DS_Store
Thumbs.db

# Python
__pycache__/

# Editors
.idea/

# Course reference photos: the phone's originals are ~5MB each and stay out
# of git; the 1400px working copies next to them are the ones we read.
/reference/*/originals/
